# SHAT environment configuration template. Copy to .env and fill in locally.
# Never commit .env. All secrets must be generated, not reused from examples.

# Backend HTTP port (integer 1-65535). Default: 3000
PORT=3000

# PostgreSQL connection string. Required for database-backed tests and the backend.
DATABASE_URL=postgres://shat:shat@localhost:5432/shat

# Comma-separated allowed CORS origins for the API. Empty means deny all origins.
CORS_ORIGINS=http://localhost:5173

# Bootstrap enrollment. Both are required; enrollment returns 503 until set.
SHAT_ENROLLMENT_TOKEN=replace-with-a-random-token
SHAT_ENROLLMENT_USER_ID=00000000-0000-4000-8000-000000000000

# TURN static auth secret for coturn use-auth-secret. At least 32 characters
# and at least 16 distinct characters. Missing or weak values fail closed.
TURN_SECRET=replace-with-at-least-32-distinct-characters
# Comma-separated turn:/turns: URIs handed to clients.
TURN_URIS=turn:localhost:3478

# Admin API token for /admin and /telemetry. At least 32 characters and at
# least 16 distinct characters. Missing or weak values fail closed.
SHAT_ADMIN_TOKEN=replace-with-at-least-32-distinct-characters

# Mobile API base URL (Expo public env). Default: http://localhost:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Web API base URL (Vite). Default: http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# Optional: enable OpenAPI generation in buildApp only when set to "1".
# SHAT_OPENAPI=1

# Optional: attachment blob directory. Default: var/attachments.
# ATTACHMENT_STORAGE_DIR=var/attachments
