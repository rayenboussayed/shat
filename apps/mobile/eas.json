{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {},
    "local": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "withoutCredentials": true,
        "buildType": "apk"
      }
    },
    "localRelease": {
      "android": {
        "credentialsSource": "local",
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
