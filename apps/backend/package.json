{
  "name": "shat-backend",
  "private": true,
  "type": "module",
  "main": "dist/apps/backend/src/main.js",
  "scripts": {
    "start": "node dist/apps/backend/src/main.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint",
    "test": "vitest run --root ../../ --config vitest.config.ts --project integration",
    "test-unit": "vitest run --root ../../ --config vitest.config.ts --project unit",
    "test-integration": "vitest run --root ../../ --config vitest.config.ts --project integration",
    "build": "tsc -p tsconfig.json",
    "gen:migrations": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:reset": "drizzle-kit push --force"
  },
  "dependencies": {
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.3.0",
    "@fastify/swagger": "9.9.5",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-fastify": "12.6.0",
    "@nestjs/platform-socket.io": "12.6.0",
    "@nestjs/terminus": "12.2.0",
    "@nestjs/websockets": "12.6.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "openapi-fetch": "0.17.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.6.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
