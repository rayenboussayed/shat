{
  "name": "shat",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": "0.0.0",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "setup": "npm install --no-audit --no-fund && npm run check",
    "prepare": "husky",
    "check": "npm run root:check && bash scripts/run-in-workspaces.sh check",
    "lint": "npm run root:lint && bash scripts/run-in-workspaces.sh lint",
    "typecheck": "npm run root:typecheck && bash scripts/run-in-workspaces.sh typecheck",
    "test": "npm run root:test && bash scripts/run-in-workspaces.sh test",
    "test:full": "npm run test && npm run test-perf && npm run test-mem",
    "test-unit": "vitest run --project unit",
    "test-integration": "vitest run --project integration",
    "test-e2e": "vitest run --project e2e",
    "test-e2e:browser": "playwright test",
    "test-cov": "vitest run --project unit --project integration --coverage",
    "test-perf": "vitest bench --config vitest.bench.config.ts",
    "test-mem": "NODE_OPTIONS=--expose-gc vitest run --project mem",
    "knip": "knip",
    "skills:sync": "nestjs-skills add --agent agents",
    "root:typecheck": "tsc -p tsconfig.root.json --noEmit",
    "root:lint": "eslint --no-error-on-unmatched-pattern .",
    "root:knip": "knip",
    "root:check": "npm run root:typecheck && npm run root:lint && npm run root:knip && npm run root:test",
    "root:test": "vitest run",
    "build": "bash scripts/run-in-workspaces.sh build",
    "db-up": "docker compose -f infrastructure/docker/compose.development.yaml up -d postgres",
    "db-down": "docker compose -f infrastructure/docker/compose.development.yaml down postgres",
    "db:migrate": "bash scripts/run-in-workspaces.sh db:migrate",
    "db-migrate": "npm run db:migrate",
    "db-reset": "bash scripts/run-in-workspaces.sh db:reset",
    "dev": "npm run dev-native",
    "dev-native": "bash scripts/run-in-workspaces.sh dev",
    "dev-docker": "docker compose -f infrastructure/docker/compose.development.yaml up -d",
    "up": "docker compose -f infrastructure/docker/compose.development.yaml up -d",
    "down": "docker compose -f infrastructure/docker/compose.development.yaml down",
    "logs": "docker compose -f infrastructure/docker/compose.development.yaml logs -f",
    "health": "bash scripts/health-check.sh",
    "compose-config": "docker compose -f infrastructure/docker/compose.development.yaml config >/dev/null",
    "gen:migrations": "bash scripts/run-in-workspaces.sh gen:migrations",
    "clean": "bash scripts/run-in-workspaces.sh clean",
    "gen:api": "npm run build -w apps/backend && node apps/backend/scripts/generate-openapi.ts && npx --yes openapi-typescript@7.13.0 packages/api-types/src/openapi.json -o packages/api-types/src/api.d.ts",
    "gen:api:check": "npm run gen:api && git diff --exit-code -- packages/api-types/src/openapi.json packages/api-types/src/api.d.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@nestjs/skills": "0.1.1",
    "@playwright/test": "1.65.1",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "husky": "9.1.7",
    "knip": "6.47.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
